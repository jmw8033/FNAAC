# The loopback bind works with Cloudflare Tunnel and keeps the game port private.
HOST=127.0.0.1
PORT=2567
# Add only the exact browser origins that will serve your game.
ALLOWED_ORIGINS=http://localhost:2567,http://127.0.0.1:2567,https://fnaac.world,https://www.fnaac.world,https://play.fnaac.world
MAX_PLAYERS=8
# Optional invitation code for a private test; leave empty for public access.
# Keep this file on the server. Never copy it into arena/ or GitHub Pages.
JOIN_CODE=

# Persistent database, relative to this project folder. Keep it off GitHub Pages.
DB_PATH=data/arena.sqlite
