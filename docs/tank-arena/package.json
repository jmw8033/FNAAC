{
  "name": "fnaac-tank-arena",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/main.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:backup": "node --env-file-if-exists=.env server/database-cli.mjs backup",
    "db:restore": "node --env-file-if-exists=.env server/database-cli.mjs restore",
    "db:check": "node --env-file-if-exists=.env server/database-cli.mjs check"
  },
  "dependencies": {
    "@colyseus/core": "0.18.12",
    "@colyseus/schema": "5.0.27",
    "@colyseus/sdk": "0.18.2",
    "@colyseus/ws-transport": "0.18.2",
    "express": "5.2.1"
  }
}
